# FG Workspace — local production Compose topology: placeholder env.
#
# Copy to deploy/.env and fill in real LOCAL values. deploy/.env is
# git-ignored by the root .gitignore (.env / .env.* rules); never
# commit real values. Compose auto-loads deploy/.env from the project
# directory (next to deploy/compose.production.yaml); passing
# `--env-file` explicitly is an equivalent alternative.

# --- Application images (required) -------------------------------------
# Prebuilt, immutable image references — Compose consumes them and never
# builds application source. For local acceptance, build local test tags
# from the current worktree (exact commands in docs/living-lab.md):
#   FG_WEB_IMAGE=fg-workspace-web:compose-topology-local
#   FG_API_IMAGE=fg-workspace-api:compose-topology-local
# FG_WEB_IMAGE=
# FG_API_IMAGE=

# --- Externally managed PostgreSQL data volume (required) --------------
# Create ONCE outside Compose; Compose never creates or deletes it:
#   docker volume create fg_production_pg16_data
# FG_POSTGRES_DATA_VOLUME=fg_production_pg16_data

# --- Database credentials (required) -----------------------------------
# First-initialization only: an already-initialized volume keeps its
# existing cluster and credentials (rotate credentials in SQL, not here).
# POSTGRES_DB=fg_workspace
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Django production contract (required) -----------------------------
# DJANGO_SECRET_KEY: non-empty, and must differ from the development key.
# DJANGO_ALLOWED_HOSTS: comma-separated hostnames; no schemes, no ports,
#   no wildcards. The local gateway is reachable at 127.0.0.1, so include it.
# DJANGO_CSRF_TRUSTED_ORIGINS: comma-separated HTTPS origins. For the
#   local topology bridge the application treats the loopback gateway as
#   https, so the matching origin is https://127.0.0.1:<FG_HTTP_PORT>.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8080

# --- Optional -----------------------------------------------------------
# Loopback gateway host port (default 8080):
# FG_HTTP_PORT=8080
