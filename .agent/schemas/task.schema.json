{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-supervisor.local/schemas/task.schema.json",
  "title": "V1 task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "base_commit",
    "goal",
    "allowed_paths",
    "forbidden_changes",
    "acceptance",
    "oracle_profile",
    "change_risk",
    "oracle_strength",
    "max_attempts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "base_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "goal": {"$ref": "#/$defs/nonEmptyString"},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "forbidden_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "oracle_profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "change_risk": {"enum": ["low", "medium", "high", "critical"]},
    "oracle_strength": {"enum": ["strong", "medium", "weak"]},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
