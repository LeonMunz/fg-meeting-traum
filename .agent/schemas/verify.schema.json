{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-supervisor.local/schemas/verify.schema.json",
  "title": "V1 verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "base_commit", "candidate_tree", "status", "phases"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "base_commit": {"$ref": "#/$defs/objectId"},
    "candidate_tree": {"anyOf": [{"$ref": "#/$defs/objectId"}, {"type": "null"}]},
    "status": {"enum": ["PASS", "FAIL", "ERROR"]},
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {"properties": {"candidate_tree": {"$ref": "#/$defs/objectId"}}},
      "else": {"properties": {"candidate_tree": {"type": "null"}}}
    }
  ],
  "$defs": {
    "objectId": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "category", "type", "location", "summary"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "verification_failure",
            "configuration_error",
            "execution_error",
            "timeout",
            "invalid_repository_state",
            "policy_violation"
          ]
        },
        "type": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "argv", "exit_code", "stdout", "stderr", "timed_out"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "ERROR", "TIMEOUT"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": ["integer", "null"]},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "timed_out": {"type": "boolean"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "status", "failures", "checks"],
      "properties": {
        "phase": {
          "enum": [
            "preconditions",
            "scope",
            "protected_oracles",
            "focused_checks",
            "static_checks",
            "full_checks",
            "policy",
            "candidate_identity"
          ]
        },
        "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIP"]},
        "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/checkResult"}}
      }
    }
  }
}
