{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-supervisor/runtime.schema.json",
  "title": "Runtime Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_inputs", "ephemeral_paths", "prepare"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "runtime_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_input_selectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ephemeral_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prepare": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "cwd", "timeout_seconds", "env"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "failure_disposition": {"type": "string", "enum": ["repairable", "terminal"]}
        }
      }
    }
  }
}
