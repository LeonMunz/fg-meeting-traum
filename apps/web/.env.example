# Local development environment (copy to .env.local, which is git-ignored).
#
# FG_API_PROXY_TARGET: backend the Vite dev-server /api proxy forwards to.
# The tracked default is http://127.0.0.1:8000. Set this only when your
# workstation runs the Django backend on a different port, e.g.:
#   FG_API_PROXY_TARGET=http://127.0.0.1:8001
# Do not commit workstation-specific values; leave the canonical default in vite.config.ts.
FG_API_PROXY_TARGET=http://127.0.0.1:8000
