# Reference for the PostgreSQL environment variables read by the backend.
#
# Django does NOT load a .env file automatically (there is no dotenv
# integration): config/settings.py reads these values from the process
# environment via os.getenv. Copying this file to .env has no effect by
# itself.
#
# To override the settings.py defaults, export the variables in the shell
# (or service/process manager) that starts the backend, e.g.:
#
#   export POSTGRES_DB=fg_workspace
#   export POSTGRES_USER=fg_workspace
#   export POSTGRES_PASSWORD=fg_workspace
#   export POSTGRES_HOST=localhost
#   export POSTGRES_PORT=5432
#
# Without overrides, the defaults in config/settings.py apply for development.
# config/settings_production.py fails closed unless every value below is
# supplied explicitly by the production process. Values here are examples,
# not production credentials, and Django does not load this file itself.

POSTGRES_DB=fg_workspace
POSTGRES_USER=fg_workspace
POSTGRES_PASSWORD=fg_workspace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production-only contract (required by config.settings_production).
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=workspace.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://workspace.example.com
